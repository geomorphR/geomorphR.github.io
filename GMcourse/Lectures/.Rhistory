data("PupfishMR")
library(RRPP)
data("PupfishMR")
PupfishMR$MR
plot(MR ~ Mass, data = PupfishMR,
pch = 19, col = as.numeric(PupfishMR$Treatment))
plot(MR ~ Mass, data = PupfishMR,
pch = 19, col = as.numeric(PupfishMR$Treatment), ylab = "log(MR")
plot(MR ~ Mass, data = PupfishMR,
pch = 19, col = as.numeric(PupfishMR$Treatment), ylab = "log(MR)", xlab = "log(Mass)")
plot(log(MR) ~ log(Mass), data = PupfishMR,
pch = 19)
fits <- fitted(fit1)
fit0 <- lm.rrpp(log(MR) ~ 1, data = PupfishMR,
iter = 9999)
fit1 <- lm.rrpp(log(MR) ~ log(Mass), data = PupfishMR,
iter = 9999, verbose = TRUE)
plot(log(MR) ~ log(Mass), data = PupfishMR,
pch = 19)
fits <- fitted(fit1)
y <- log(PupfishMR$MR)
x <- log(PupfishMR$Mass)
for(i in 1:length(fits)) {
lines(rbind(c(x[i], y[i]), c(x[i], fits[i])), lty = 3)
}
abline(fit1, col = "blue")
points(log(PupfishMR$Mass), fitted(fit1), pch = 19, col = "blue")
pred.y <- predict(fit1, confidence = 0.95)
plot(log(MR) ~ log(Mass), data = PupfishMR,
pch = 21, cex = 1, bg = "gray",
ylim = c(-2.5, 0), type = "n")
abline(fit1, col = "black", lwd = 2)
points(log(PupfishMR$Mass), fitted(fit1),
pch = 19, col = "black", cex = 1.5)
arrows(log(PupfishMR$Mass), pred.y$mean,
log(PupfishMR$Mass), pred.y$lcl,
length = 0.1, lwd=2, angle = 90)
arrows(log(PupfishMR$Mass), pred.y$mean,
log(PupfishMR$Mass), pred.y$ucl,
length = 0.1, lwd=2, angle = 90)
new.Mass <- c(0.30, 1.25, 2.30)
pred.new <- predict(fit1,newdata = rrpp.data.frame(Mass = new.Mass), confidence = 0.95)
plot(log(new.Mass),pred.new$random.predicted[[1]],
pch = 21, cex = 2, bg = "black",
ylab = "log(MR)", xlab = "log(Mass)",
ylim = c(-2,.5))
arrows(log(new.Mass), pred.new$random.predicted[[1]],
log(new.Mass), pred.new$lcl,
length = 0.1, lwd=2, angle = 90)
arrows(log(new.Mass), pred.new$random.predicted[[1]],
log(new.Mass), pred.new$ucl,
length = 0.1, lwd=2, angle = 90)
