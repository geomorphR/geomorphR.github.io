type = "intercepts",
data = ReptAbund, estimation = "REML")
tbl.randint <- anova(fit.rept.reml, error = c("Site", "Residuals"))$table
ICC3 <- (tbl.randint$MS[2] - tbl.randint$MS[3]) / (tbl.randint$MS[2] + (n_0 -1) * tbl.randint$MS[3])
knitr::kable(round(tbl.randint,3), format="markdown", booktabs = TRUE,
caption = "ANOVA table of fixed effects from a random intercepts hierarchical mixed model comparing the log of reptile abundance across years, given random variation among sites.  REML estimation is used.")
install.packages("faux")
install.packages("car")
install.packages("sf")
library(RRPP)
data('snakeHS')
gp <- as.factor(paste(snakeHS$Region, snakeHS$Sex))
Model <- c("S", "R","SVL", "SVL.R", "SVL.R.SVL:R", "SVL.S", "SVL.S.SVL:S", "CmSlp", "Full")
Terms <- c("HS ~ S", "HS ~ R", "HS ~ SVL", "HS ~ SVL + R",
"HS ~ SVL + R + SVL:R", "HS ~ SVL + S", "HS ~ SVL + S + SVL:S",
"HS ~ SVL + S + R + S:R", "HS ~ SVL + S + R + S:R + SVL:S + SVL:R + SVL:S:R")
tbl1 <- cbind(Model,Terms)
f.0 <- lm.rrpp(HS ~ 1, data = snakeHS)
f.svl <- lm.rrpp(HS ~ SVL, data = snakeHS)
f.sex <- lm.rrpp(HS ~ Sex, data = snakeHS)
f.reg <- lm.rrpp(HS ~ Region, data = snakeHS)
f.svl.reg <- lm.rrpp(HS ~ SVL + Region, data = snakeHS, SS.type = "II")
f.svl.by.reg <- lm.rrpp(HS ~ SVL * Region, data = snakeHS, SS.type = "II")
f.svl.sex <- lm.rrpp(HS ~ SVL + Sex, data = snakeHS, SS.type = "II")
f.svl.by.sex <- lm.rrpp(HS ~ SVL * Sex, data = snakeHS, SS.type = "II")
f.cmslp <- lm.rrpp(HS ~ SVL + Sex * Region, data = snakeHS, SS.type = "II")
f.full <- lm.rrpp(HS ~ SVL * Sex * Region, data = snakeHS, SS.type = "II")
comp.lrt <- model.comparison(f.0, f.svl, f.sex, f.reg, f.svl.reg, f.svl.by.reg,
f.svl.sex, f.svl.by.sex, f.cmslp, f.full, type = "logLik")
comp.Z <- model.comparison(f.0, f.svl, f.sex, f.reg, f.svl.reg, f.svl.by.reg,
f.svl.sex, f.svl.by.sex, f.cmslp, f.full,
type = "Z", verbose = TRUE)
comp.lrt$names <- comp.Z$names <- c("Int", "SVL", "S", "R", "SVL.R", "SVL.R.SVL:R", "SVL.S", "SVL.S.SVL:S", "CmSlp", "Full")
tbl.global <- anova(f.full)$table
options(knitr.kable.NA = '')
knitr::kable(round(tbl.global,3), format="markdown", booktabs = TRUE,
caption = "ANOVA table describing variation in head size based on a global model containing all model effects.  Type II sums of squares was used.")
tbl.svl.reg <- anova(f.svl.reg)$table
options(knitr.kable.NA = '')
knitr::kable(round(tbl.svl.reg,3), format="markdown", booktabs = TRUE,
caption = "ANOVA table describing variation in head size with SVL and region as model effects.")
tbl.svl.by.reg <- anova(f.svl.by.reg)$table
options(knitr.kable.NA = '')
knitr::kable(round(tbl.svl.by.reg,3), format="markdown", booktabs = TRUE,
caption = "ANOVA table describing variation in head size with SVL and region and SVL:region as model effects.")
tbl.aovCompare <- anova(f.svl.reg, f.svl.by.reg, effect.type = "LR",
print.progress = FALSE)$table
tbl.aovCompare[, 6:8] <- round(tbl.aovCompare[, 6:8],3)
options(knitr.kable.NA = '')
knitr::kable(tbl.aovCompare[1:2, c(3,7:10)], format="markdown", booktabs = TRUE,
caption = "Likelihood ratio test comparing the fit of a model containing SVL and region to a model containing SVL, region, and their interaction.")
tbl.AIC <- comp.lrt$table[order(comp.lrt$table$AIC),-c(1:2)]
rownames(tbl.AIC) <- comp.lrt$names[order(comp.lrt$table$AIC)]
options(knitr.kable.NA = '')
knitr::kable(round(tbl.AIC,3), format="markdown", booktabs = TRUE,
