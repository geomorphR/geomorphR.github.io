s.fact.build <- function(p, k, sb, sw, sk, mod.gp) {
mod.gp <- as.factor(mod.gp)
Sp <- matrix(sb, p, p)
Sp[outer(mod.gp, mod.gp, "==")] <- sw
ii <- lower.tri(Sp)
Sp[ii] <- Sp[ii] + rnorm(sum(ii), 0, 0.01)
Sp[upper.tri(Sp)] <- t(Sp)[upper.tri(Sp)]
diag(Sp) <- rnorm(p, 1, 0.01)
Sk <- matrix(sk, k, k)
jj <- lower.tri(Sk)
Sk[jj] <- Sk[jj] + rnorm(sum(jj), 0, 0.01)
Sk[upper.tri(Sk)] <- t(Sk)[upper.tri(Sk)]
diag(Sk) <- rnorm(k, 1, 0.01)
S <- kronecker(Sp,Sk)
if (min(eigen(S, symmetric = TRUE, only.values = TRUE)$values) < 0)
S <- as.matrix(Matrix::nearPD(S)$mat)
S
}
mn <- geomorph:::center.scale(matrix(c(-3.5,1, -2,.8, 0,1.2, 0, -1,
-2, -.6, -3,-.4, 1.5,2.5, 2,2,
3,2, 2.5,0.6, 3, 0,
2.5, -1.2), ncol = 2, byrow = T))$coords
s.fact.build <- function(p, k, sb, sw, sk, mod.gp) {
mod.gp <- as.factor(mod.gp)
Sp <- matrix(sb, p, p)
Sp[outer(mod.gp, mod.gp, "==")] <- sw
ii <- lower.tri(Sp)
Sp[ii] <- Sp[ii] + rnorm(sum(ii), 0, 0.01)
Sp[upper.tri(Sp)] <- t(Sp)[upper.tri(Sp)]
diag(Sp) <- rnorm(p, 1, 0.01)
Sk <- matrix(sk, k, k)
jj <- lower.tri(Sk)
Sk[jj] <- Sk[jj] + rnorm(sum(jj), 0, 0.01)
Sk[upper.tri(Sk)] <- t(Sk)[upper.tri(Sk)]
diag(Sk) <- rnorm(k, 1, 0.01)
S <- kronecker(Sp,Sk)
if (min(eigen(S, symmetric = TRUE, only.values = TRUE)$values) < 0)
S <- as.matrix(Matrix::nearPD(S)$mat)
S
}
