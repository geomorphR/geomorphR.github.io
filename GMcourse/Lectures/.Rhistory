# Simulation-based Integration test: Type I error & power
#using new normF approach to Sim.iso
#type I error fine
library(geomorph)
library(mvtnorm)
n <- 200
p <- 12
k <- 2
var.in <- 1/ (p*k)^2
nsims <- 100
land.gps <- gl(2,p/2)
cir <- geomorph:::center.scale(
t(sapply(1:p,function(r)c(cos(2*r*pi/p),sin(2*r*pi/p)))))$coords
star <- cir
star[c(2,4,6,8,10,12),] <-   star[c(2,4,6,8,10,12),] * .5
star <- geomorph:::center.scale(star)$coords
mand <- geomorph:::center.scale(matrix(c(-3.5,1, -2,.8, 0,1.2, 0, -1,
-2, -.6, -3,-.4, 1.5,2.5, 2,2,
3,2, 2.5,0.6, 3, 0,
2.5, -1.2), ncol = 2, byrow = T))$coords
fish <- geomorph:::center.scale(matrix(c(-5,0, -4,1, -3.5,.3, -1.5,1.2, -4,-.7,
-1.5,-1, 0,2.5, 1,1.2, 3,0.3, 4,1.5,
4,-1.5, 3,-.3), ncol = 2, byrow = T))$coords
means <- list(cir, star, mand, fish)
names(means) <- c("cir", "star", "mand", "fish")
############### POWER
s.fact.build <- function(p, k, sb, sw, sk, mod.gp) {
mod.gp <- as.factor(mod.gp)
Sp <- matrix(sb, p, p)
Sp[outer(mod.gp, mod.gp, "==")] <- sw
ii <- lower.tri(Sp)
diag(Sp) <- 1
Sk <- matrix(sk, k, k)
diag(Sk) <- 1
S <- kronecker(Sp,Sk)
if (min(eigen(S, symmetric = TRUE, only.values = TRUE)$values) < 0)
S <- as.matrix(Matrix::nearPD(S)$mat)
S
}
S.in <- s.fact.build(p = p, k = k, sb = 0.6, sw = 0.2,
sk = 0.7, mod.gp = land.gps) * var.in
sim.results.p <- lapply(seq_len(length(means)), function(jj){
mn <- means[[jj]]
result <- t(sapply(1:nsims, function(i){
cat("sim", i, " ")
E <- rmvnorm(n, mean = rep(0,p*k), sigma = S.in)
x <- arrayspecs(matrix(unlist(lapply(1:n, function(j) E[j,] + matrix(t(mn)))),
nrow = n, byrow = TRUE),p,k)
Y.gpa <- gpagen(x, print.progress = F)
IT.gpa <- integration.test(A = Y.gpa$coords, partition.gp = land.gps,
print.progress = F)
#simulation-based
mn.gpa <- mshape(Y.gpa$coords)
S.gpa <- cov(two.d.array(Y.gpa$coords))
S.norm <- norm(S.gpa, type = "F")
sigma.sim <- sqrt(S.norm^2/(p*k))
S.in <-   diag(sigma.sim, p*k)
IT.rand <- sapply(1:1000, function(j) {
dat.sim <- gpagen(arrayspecs(rmvnorm(n,mean = matrix(t(mn.gpa)),
sigma=S.in),p,k),
print.progress = F)
integration.test(dat.sim$coords, iter = 0, partition.gp = land.gps,
print.progress = F)$r.pls
})
IT.rand[1] <- IT.gpa$r.pls
IT.sim.pval <- pval(IT.rand)
IT.sim.Z <- effect.size(IT.rand)
out <- list(gpa.P = IT.gpa$P.value,
sim.P <- IT.sim.pval,
sim.Z <- IT.sim.Z)
out
}))
result
})
p.res.p <- simplify2array(lapply(seq_len(length(means)), function(jj){
apply(sim.results.p[[jj]],2, function(y) length(which(y <= 0.05)) / nsims) }))
colnames(p.res.p) <- names(means)
rownames(p.res.p) <- c("gpa.P", "sim.P","")
t(p.res.p)[,1:2]
