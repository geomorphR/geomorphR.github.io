library(RRPP)
library(lattice)
library(kableExtra)
quiet <- function(x) {
sink(tempfile())
on.exit(sink())
invisible(force(x))
}  #for silencing 'cat' statements
fit1 <- lm.rrpp(y1 ~ Gp, iter = iter)
fit2 <- lm.rrpp(y2 ~ Gp,iter = iter)
res <-quiet(model.comparison(fit1, fit2, verbose = TRUE, type = "Z"))
Z1.bc <- RRPP:::center(RRPP:::powerTrans(res$random.logL$fit1)$transformed)
Z2.bc <- RRPP:::center(RRPP:::powerTrans(res$random.logL$fit2)$transformed)
set.seed(123)
iter = 9999
n = 100
b1 = 0.1
b2 = 0.9
Gp <- c(rep(0,n/2),rep(1,n/2))
e1 <- rnorm(n, mean = 0, sd = 1)
e2 <- rnorm(n, mean = 0, sd = .5)
y1 <- Gp * b1 + e1
y2 <- Gp * b2 + e2
Gp <- as.factor(Gp)
fit1 <- lm.rrpp(y1 ~ Gp, iter = iter)
fit2 <- lm.rrpp(y2 ~ Gp,iter = iter)
res <-quiet(model.comparison(fit1, fit2, verbose = TRUE, type = "Z"))
Z1.bc <- RRPP:::center(RRPP:::powerTrans(res$random.logL$fit1)$transformed)
Z2.bc <- RRPP:::center(RRPP:::powerTrans(res$random.logL$fit2)$transformed)
hist(res$random.logL$fit1, breaks = 40, col = "darkgray",
xlim = range(res$random.logL), xlab = "log-likelihood", main = "Original Distributions")
hist(res$random.logL$fit2, breaks = 40, col = "lightblue", add = TRUE)
hist(Z1.bc, breaks = 40, col = "darkgray", xlim = range(c(Z1.bc,Z2.bc)),
xlab ="Z", main = "Power-Transformed and Combined")
hist(Z2.bc, breaks = 40, col = "lightblue", add = TRUE)
abline(v = Z1.bc[1], lwd = 3, col = "black")
abline(v = Z2.bc[1], col = "lightblue", lwd = 3)
