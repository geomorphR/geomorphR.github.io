library(RRPP)
library(lattice)
library(kableExtra)
quiet <- function(x) {
sink(tempfile())
on.exit(sink())
invisible(force(x))
}  #for silencing 'cat' statements
fit1 <- lm.rrpp(y1 ~ Gp, iter = iter)
fit2 <- lm.rrpp(y2 ~ Gp,iter = iter)
res <-quiet(model.comparison(fit1, fit2, verbose = TRUE, type = "Z"))
Z1.bc <- RRPP:::center(RRPP:::powerTrans(res$random.logL$fit1)$transformed)
Z2.bc <- RRPP:::center(RRPP:::powerTrans(res$random.logL$fit2)$transformed)
set.seed(123)
iter = 9999
n = 100
b1 = 0.1
b2 = 0.9
Gp <- c(rep(0,n/2),rep(1,n/2))
e1 <- rnorm(n, mean = 0, sd = 1)
e2 <- rnorm(n, mean = 0, sd = .5)
y1 <- Gp * b1 + e1
y2 <- Gp * b2 + e2
Gp <- as.factor(Gp)
fit1 <- lm.rrpp(y1 ~ Gp, iter = iter)
fit2 <- lm.rrpp(y2 ~ Gp,iter = iter)
res <-quiet(model.comparison(fit1, fit2, verbose = TRUE, type = "Z"))
Z1.bc <- RRPP:::center(RRPP:::powerTrans(res$random.logL$fit1)$transformed)
Z2.bc <- RRPP:::center(RRPP:::powerTrans(res$random.logL$fit2)$transformed)
hist(res$random.logL$fit1, breaks = 40, col = "darkgray",
xlim = range(res$random.logL), xlab = "log-likelihood", main = "Original Distributions")
hist(res$random.logL$fit2, breaks = 40, col = "lightblue", add = TRUE)
hist(Z1.bc, breaks = 40, col = "darkgray", xlim = range(c(Z1.bc,Z2.bc)),
xlab ="Z", main = "Power-Transformed and Combined")
hist(Z2.bc, breaks = 40, col = "lightblue", add = TRUE)
abline(v = Z1.bc[1], lwd = 3, col = "black")
abline(v = Z2.bc[1], col = "lightblue", lwd = 3)
load('data/podarcis.rda')
podarcis$SVL <- log(podarcis$SVL)
transect.data <- split(podarcis, f = podarcis$GROUP)
Hab <- factor(c("Sax", "Gen", "Gen", "Sax", "Sax", "Sax", "Sax", "Gen",
"Sax", "Gen", "Gen", "Sax", "Gen", "Gen", "Sax"))
names(Hab) <- names(transect.data)
podarcis$Hab <- Hab[match(podarcis$GROUP, names(Hab))]
podarcis$GP2 <- paste(podarcis$GROUP, podarcis$Hab, sep = "-")
lattice::bwplot(SVL ~ SEX | GP2, podarcis,
scales=list(alternating=T, y=list(relation="free")),
xlab = "Sex", ylab = "log(SVL)")
mn.SVL <- tapply(podarcis$SVL,INDEX = paste(podarcis$GROUP, podarcis$SEX), mean)
mn.SVL.mat <- matrix(mn.SVL, ncol = 2, byrow = TRUE)
plot(x = rep(1, 15), y = mn.SVL.mat[,1], pch = 21, bg = "black",
xlim = c(.5, 2.5), ylim = range(mn.SVL),
ylab = "log(SVL)",
xlab = "Sex", xaxt = "n")
points(x = rep(2, 15), y = mn.SVL.mat[,2], pch = 21, bg = "black")
segments(x0 = rep(1, 15),
y0 = mn.SVL.mat[,1],
x1 = rep(2, 15),
y1 = mn.SVL.mat[,2],
col = Hab, lwd=2)
mtext(text = c("Female", "Male"),
side = 1, at = c(1, 2), line = 1)
legend('topleft', legend = c("Sax", "Gen"), lty = 1,
col = unique(Hab), lwd = 2)
fit.anova <- lapply(1: length(transect.data), function(j) {
lm.rrpp(SVL ~ SEX, data = transect.data[[j]])
})
res <- lapply(1: length(transect.data), function(j) {
rbind(rep(NA,7),anova(fit.anova[[j]])$table)
})
res.tbl <- do.call(rbind, res)
rownames(res.tbl) <- NULL
rn <- unlist(lapply(1:15, function(j){
c(paste(names(Hab), Hab, sep = "-")[j],"Sex","Residuals","Total")}))
res.tbl <- cbind(rn,res.tbl)
colnames(res.tbl)[1] <- ""
res.tbl[,2:8] <- round(res.tbl[,2:8],3)
res.tbl
