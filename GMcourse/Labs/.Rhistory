fit.anova[[11]], fit.anova[[12]],
fit.anova[[13]], fit.anova[[14]],
fit.anova[[15]],
type = "Z", verbose = TRUE))
res.tbl2 <- aov.comp$table
rownames(res.tbl2) <- paste(names(transect.data), Hab, sep = "-")
res.tbl2
