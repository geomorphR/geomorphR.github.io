setwd("C:/DeanData/Teaching/Workshops/geomorphR.github.io/geomorphR.github.io/GMcourse/Labs")
## Visualizing 3D shapes
scallops <- readland.tps("Data/scallops for viz.tps", specID = "ID")
ref <- mshape(scallops)
refmesh <- warpRefMesh(read.ply("Data/glyp02L.ply"),
scallops[,,1], ref, centered=T)
PCA.scallop <- gm.prcomp(scallops)
plot(PCA.scallop, pch = 21, bg = "black", cex = 2)
PC.sc <- PCA.scallop$x[,1]
sc.preds <- shape.predictor(scallops, x= PC.sc, Intercept = FALSE,
pred1 = min(PC.sc), pred2 = max(PC.sc)) # PC 1 extremes
# Saving deformed PLY
PC.example <- plotRefToTarget(ref, sc.preds$pred2, mesh = refmesh, method = "surface", mag = 1)
m <- Filter(function(x) identical(x$type, "mesh3d"), traces)[[1]]
traces <- plotly::plotly_build(fig)$x$data
source("C:/DeanData/Teaching/Workshops/geomorphR.github.io/geomorphR.github.io/GMcourse/Labs/01-Day01-RCode.R", echo = TRUE)
traces <- plotly::plotly_build(PC.example)$x$data
m <- Filter(function(x) identical(x$type, "mesh3d"), traces)[[1]]
stopifnot(!is.null(m$i), !is.null(m$j), !is.null(m$k))
mesh <- rgl::tmesh3d(
vertices = rbind(m$x, m$y, m$z),
indices  = rbind(m$i, m$j, m$k) + 1,
homogeneous = FALSE
)
library(Rvcg)
vcgPlyWrite(mesh, filename= "PC.example.ply", writeCol = FALSE)
read.ply("PC.example.ply")
vcgPlyWrite(mesh, filename= "PC.example.ply")
read.ply("PC.example.ply")
Rvcg::vcgPlyWrite(mesh, filename = "PC.example.ply", binary = FALSE)
PC.mesh <- geomorph::read.ply("PC.example.ply")
# Saving deformed PLY (convert plotly to rgl style)
PC.example <- plotRefToTarget(ref, sc.preds$pred2, mesh = refmesh, method = "surface", mag = 1)
# Convert plotly to rgl style
m <- Filter(function(x) identical(x$type, "mesh3d"),
plotly::plotly_build(PC.example)$x$data)[[1]]
mesh <- with(m, rgl::tmesh3d(
rbind(x, y, z), rbind(i, j, k) + 1, homogeneous = FALSE
))
cols <- if (!is.null(m$vertexcolor)) m$vertexcolor else m$color
if (!is.null(cols)) {
cols <- vapply(unlist(cols), function(cl) {
if (grepl("^rgba?\\(", cl)) {
v <- as.numeric(strsplit(gsub("[rgba() ]", "", cl), ",")[[1]])
cl <- grDevices::rgb(v[1], v[2], v[3], maxColorValue = 255)
}
cl
}, character(1))
mesh$material$color <- rep(cols, length.out = ncol(mesh$vb))
}
str(m$vertexcolor)
str(m$color)
# Convert plotly to rgl style
m <- Filter(function(x) identical(x$type, "mesh3d"),
plotly::plotly_build(PC.example)$x$data)[[1]]
mesh <- with(m, rgl::tmesh3d(
rbind(x, y, z), rbind(i, j, k) + 1, homogeneous = FALSE
))
mesh$material$color <- grDevices::rgb(
m$vertexcolor[, "red"],
m$vertexcolor[, "green"],
m$vertexcolor[, "blue"],
maxColorValue = 255
)
library(Rvcg)
Rvcg::vcgPlyWrite(mesh, filename = "PC.example.ply", binary = FALSE)
PC.mesh <- geomorph::read.ply("PC.example.ply")
# Saving deformed PLY
PC.example <- plotRefToTarget(ref, sc.preds$pred2, mesh = refmesh, method = "surface", mag = 1)
# Convert plotly to rgl style
m <- Filter(function(x) identical(x$type, "mesh3d"),
plotly::plotly_build(PC.example)$x$data)[[1]]
mesh <- with(m, rgl::tmesh3d(
rbind(x, y, z), rbind(i, j, k) + 1, homogeneous = FALSE
))
mesh$material$color <- grDevices::rgb(
m$vertexcolor[, "red"],
m$vertexcolor[, "green"],
m$vertexcolor[, "blue"],
maxColorValue = 255
)
Rvcg::vcgPlyWrite(mesh, filename = "PC.example.ply",
binary = FALSE, , writeCol = TRUE)
PC.mesh <- geomorph::read.ply("PC.example.ply")
Rvcg::vcgPlyWrite(mesh, filename = "PC.example.ply",
binary = FALSE, , writeCol = TRUE, writeNormals = FALSE)
PC.mesh <- geomorph::read.ply("PC.example.ply")
