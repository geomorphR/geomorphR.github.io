axis(1, at = bp[seq(1, length(bp), by = 10)],
labels = round(seq(0, 1, length.out = 11), 1))
par(new = TRUE)
barplot(out2, col = "blue", ylab = "", yaxt = "n", axes = FALSE)
n <- 100
y <- 0:n
out1 <- dbinom(y, n, .5)
out2 <- dbinom(y, n, .8)
bp <- barplot(out1, ylab = "Probability", xlab = "", names.arg = FALSE)
axis(1, at = bp[seq(1, length(bp), by = 10)],
labels = round(seq(0, 1, length.out = 11), 1))
par(new = TRUE)
barplot(out2, col = "blue", ylab = "", yaxt = "n", axes = FALSE)
